{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@lm-linter/model": ["./packages/model/src/index.ts"],
      "@lm-linter/engine": ["./packages/engine/src/index.ts"],
      "@lm-linter/rules": ["./packages/rules/src/index.ts"],
      "@lm-linter/report": ["./packages/report/src/index.ts"]
    }
  },
  "include": ["packages/*/src", "apps/*/src"]
}
