{
  "name": "lm-linter",
  "version": "0.3.0",
  "description": "Capability-based effect tracking and type linting for TypeScript projects",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "lm-linter": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "lint": "bun src/cli.ts cap",
    "dev": "bun --watch src/cli.ts cap",
    "test": "bun test"
  },
  "dependencies": {
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^5.0.0"
  },
  "files": [
    "dist/"
  ]
}
